# Postgres connection string. Leave unset for local development (embedded database in .data/).
# Supabase: use the "Transaction pooler" URI (port 6543).
DATABASE_URL=

# One-time key for /setup (creating the first account on a fresh deployment). Optional afterwards.
SETUP_KEY=

# Email akun Post System (pisahkan dengan koma) yang boleh melihat dan menautkan drive-tracker. Kosong = tidak ada yang boleh.
DRIVE_TRACKER_ADMINS=

# Web push + pengingat harian. Buat kunci dengan `node scripts/gen-vapid.mjs`. Kosong = fitur push tersembunyi.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Teks acak panjang; Vercel Cron mengirimnya sebagai "Authorization: Bearer ..." ke /api/cron/daily.
CRON_SECRET=
